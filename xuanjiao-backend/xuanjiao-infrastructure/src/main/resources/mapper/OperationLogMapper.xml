<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xuanjiao.infrastructure.log.OperationLogMapper">

    <resultMap id="BaseResultMap" type="com.xuanjiao.infrastructure.dataobject.OperationLogDO">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="operator_id" property="operatorId" jdbcType="BIGINT"/>
        <result column="operator_name" property="operatorName" jdbcType="VARCHAR"/>
        <result column="operation_type" property="operationType" jdbcType="VARCHAR"/>
        <result column="target_type" property="targetType" jdbcType="VARCHAR"/>
        <result column="target_id" property="targetId" jdbcType="BIGINT"/>
        <result column="target_name" property="targetName" jdbcType="VARCHAR"/>
        <result column="operation_detail" property="operationDetail" jdbcType="LONGVARCHAR"/>
        <result column="ip_address" property="ipAddress" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, operator_id, operator_name, operation_type, target_type, target_id, target_name,
        operation_detail, ip_address, create_time
    </sql>

    <!-- ==================== 基础CRUD方法 ==================== -->

    <select id="selectById" resultMap="BaseResultMap" parameterType="java.lang.Long">
        SELECT <include refid="Base_Column_List"/>
        FROM operation_log
        WHERE id = #{id}
        LIMIT 1
    </select>

    <select id="selectOne" resultMap="BaseResultMap" parameterType="com.xuanjiao.infrastructure.log.OperationLogQuery">
        SELECT <include refid="Base_Column_List"/>
        FROM operation_log
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="operatorId != null">
                AND operator_id = #{operatorId}
            </if>
            <if test="operationType != null and operationType != ''">
                AND operation_type = #{operationType}
            </if>
            <if test="targetType != null and targetType != ''">
                AND target_type = #{targetType}
            </if>
            <if test="targetId != null">
                AND target_id = #{targetId}
            </if>
        </where>
        ORDER BY create_time DESC
        LIMIT 1
    </select>

    <select id="selectList" resultMap="BaseResultMap" parameterType="com.xuanjiao.infrastructure.log.OperationLogQuery">
        SELECT <include refid="Base_Column_List"/>
        FROM operation_log
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="operatorId != null">
                AND operator_id = #{operatorId}
            </if>
            <if test="operationType != null and operationType != ''">
                AND operation_type = #{operationType}
            </if>
            <if test="targetType != null and targetType != ''">
                AND target_type = #{targetType}
            </if>
            <if test="targetId != null">
                AND target_id = #{targetId}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="selectCount" resultType="java.lang.Long" parameterType="com.xuanjiao.infrastructure.log.OperationLogQuery">
        SELECT COUNT(*)
        FROM operation_log
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="operatorId != null">
                AND operator_id = #{operatorId}
            </if>
            <if test="operationType != null and operationType != ''">
                AND operation_type = #{operationType}
            </if>
            <if test="targetType != null and targetType != ''">
                AND target_type = #{targetType}
            </if>
            <if test="targetId != null">
                AND target_id = #{targetId}
            </if>
        </where>
    </select>

    <insert id="insert" parameterType="com.xuanjiao.infrastructure.dataobject.OperationLogDO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO operation_log (operator_id, operator_name, operation_type, target_type, target_id,
                                  target_name, operation_detail, ip_address)
        VALUES (#{operatorId}, #{operatorName}, #{operationType}, #{targetType}, #{targetId},
                #{targetName}, #{operationDetail}, #{ipAddress})
    </insert>

    <update id="updateById" parameterType="com.xuanjiao.infrastructure.dataobject.OperationLogDO">
        UPDATE operation_log
        <set>
            <if test="operatorId != null">
                operator_id = #{operatorId},
            </if>
            <if test="operatorName != null and operatorName != ''">
                operator_name = #{operatorName},
            </if>
            <if test="operationType != null and operationType != ''">
                operation_type = #{operationType},
            </if>
            <if test="targetType != null and targetType != ''">
                target_type = #{targetType},
            </if>
            <if test="targetId != null">
                target_id = #{targetId},
            </if>
            <if test="targetName != null and targetName != ''">
                target_name = #{targetName},
            </if>
            <if test="operationDetail != null">
                operation_detail = #{operationDetail},
            </if>
            <if test="ipAddress != null and ipAddress != ''">
                ip_address = #{ipAddress},
            </if>
        </set>
        WHERE id = #{id}
    </update>

</mapper>
