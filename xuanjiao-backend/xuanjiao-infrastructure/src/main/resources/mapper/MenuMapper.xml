<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xuanjiao.infrastructure.menu.MenuMapper">

    <!-- Result Map -->
    <resultMap id="BaseResultMap" type="com.xuanjiao.infrastructure.dataobject.MenuDO">
        <id column="id" property="id"/>
        <result column="parent_id" property="parentId"/>
        <result column="name" property="name"/>
        <result column="type" property="type"/>
        <result column="path" property="path"/>
        <result column="component" property="component"/>
        <result column="icon" property="icon"/>
        <result column="sort" property="sort"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <!-- Base Column List -->
    <sql id="Base_Column_List">
        id, parent_id, name, type, path, component, icon, sort, status, create_time, update_time, deleted
    </sql>

    <!-- Select By ID -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_menu
        WHERE id = #{id} AND deleted = 0
    </select>

    <!-- Select List with Dynamic Conditions -->
    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_menu
        <where>
            <if test="deleted == null">deleted = 0</if>
            <if test="deleted != null">deleted = #{deleted}</if>
            <if test="id != null">AND id = #{id}</if>
            <if test="parentId != null">AND parent_id = #{parentId}</if>
            <if test="name != null and name != ''">AND name = #{name}</if>
            <if test="type != null and type != ''">AND type = #{type}</if>
            <if test="path != null and path != ''">AND path = #{path}</if>
            <if test="component != null and component != ''">AND component = #{component}</if>
            <if test="icon != null and icon != ''">AND icon = #{icon}</if>
            <if test="sort != null">AND sort = #{sort}</if>
            <if test="status != null">AND status = #{status}</if>
        </where>
        <if test="orderByField != null and orderByField != ''">
            ORDER BY ${orderByField}
            <if test="orderByDirection != null and orderByDirection != ''">
                ${orderByDirection}
            </if>
        </if>
        <if test="orderByField == null or orderByField == ''">
            ORDER BY sort ASC
        </if>
    </select>

    <!-- Select Count -->
    <select id="selectCount" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM sys_menu
        <where>
            <if test="deleted == null">deleted = 0</if>
            <if test="deleted != null">deleted = #{deleted}</if>
            <if test="id != null">AND id = #{id}</if>
            <if test="parentId != null">AND parent_id = #{parentId}</if>
            <if test="name != null and name != ''">AND name = #{name}</if>
            <if test="type != null and type != ''">AND type = #{type}</if>
            <if test="path != null and path != ''">AND path = #{path}</if>
            <if test="component != null and component != ''">AND component = #{component}</if>
            <if test="icon != null and icon != ''">AND icon = #{icon}</if>
            <if test="sort != null">AND sort = #{sort}</if>
            <if test="status != null">AND status = #{status}</if>
        </where>
    </select>

    <!-- Select Menu IDs By Role ID (from sys_role_menu) -->
    <select id="selectMenuIdsByRoleId" resultType="java.lang.Long">
        SELECT menu_id FROM sys_role_menu WHERE role_id = #{roleId}
    </select>

    <!-- Select Menus By User ID (with JOINs) -->
    <select id="selectMenusByUserId" resultMap="BaseResultMap">
        SELECT DISTINCT m.*
        FROM sys_menu m
        INNER JOIN sys_role_menu rm ON m.id = rm.menu_id
        INNER JOIN sys_user u ON rm.role_id = u.role_id
        WHERE u.id = #{userId} AND m.deleted = 0 AND m.status = 1
        ORDER BY m.sort
    </select>

    <!-- Insert -->
    <insert id="insert" parameterType="com.xuanjiao.infrastructure.dataobject.MenuDO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_menu (parent_id, name, type, path, component, icon, sort, status, deleted)
        VALUES (#{parentId}, #{name}, #{type}, #{path}, #{component}, #{icon}, #{sort}, #{status}, 0)
    </insert>

    <!-- Update By ID -->
    <update id="updateById" parameterType="com.xuanjiao.infrastructure.dataobject.MenuDO">
        UPDATE sys_menu
        <set>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="type != null and type != ''">type = #{type},</if>
            <if test="path != null">path = #{path},</if>
            <if test="component != null">component = #{component},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- Delete By ID (Soft Delete using @TableLogic) -->
    <update id="deleteById">
        UPDATE sys_menu SET deleted = 1 WHERE id = #{id}
    </update>

</mapper>
