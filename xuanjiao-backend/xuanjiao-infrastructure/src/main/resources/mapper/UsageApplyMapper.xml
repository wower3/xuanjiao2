<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xuanjiao.infrastructure.usage.UsageApplyMapper">

    <!-- 结果映射：column是数据库字段（下划线），property是Java属性（驼峰） -->
    <resultMap id="BaseResultMap" type="com.xuanjiao.infrastructure.dataobject.UsageApplyDO">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="title" property="title" jdbcType="VARCHAR"/>
        <result column="purpose" property="purpose" jdbcType="VARCHAR"/>
        <result column="scope" property="scope" jdbcType="VARCHAR"/>
        <result column="workflow_id" property="workflowId" jdbcType="BIGINT"/>
        <result column="status" property="status" jdbcType="VARCHAR"/>
        <result column="approval_instance_id" property="approvalInstanceId" jdbcType="BIGINT"/>
        <result column="attachment_path" property="attachmentPath" jdbcType="VARCHAR"/>
        <result column="is_secondary_creation" property="isSecondaryCreation" jdbcType="INTEGER"/>
        <result column="publish_channel" property="publishChannel" jdbcType="VARCHAR"/>
        <result column="dept_id" property="deptId" jdbcType="BIGINT"/>
        <result column="draft" property="draft" jdbcType="INTEGER"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="deleted" property="deleted" jdbcType="INTEGER"/>
    </resultMap>

    <!-- 基础字段列表（数据库字段，下划线命名） - 禁止 SELECT * -->
    <sql id="Base_Column_List">
        id, user_id, title, purpose, scope, workflow_id, status, approval_instance_id,
        attachment_path, is_secondary_creation, publish_channel, dept_id, draft,
        create_time, update_time, deleted
    </sql>

    <!-- 根据主键查询 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM usage_apply
        <where>
            id = #{id}
            AND deleted = 0
        </where>
        LIMIT 1
    </select>

    <!-- 动态条件查询 -->
    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM usage_apply
        <where>
            <!-- deleted 参数处理 -->
            <if test="deleted != null">
                deleted = #{deleted}
            </if>
            <if test="deleted == null">
                deleted = 0
            </if>

            <!-- 单值参数 -->
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="draft != null">
                AND draft = #{draft}
            </if>
            <if test="deptId != null">
                AND dept_id = #{deptId}
            </if>

            <!-- IN 查询 -->
            <if test="statusList != null and statusList.size() > 0">
                AND status IN
                <foreach collection="statusList" item="status" open="(" separator="," close=")">
                    #{status}
                </foreach>
            </if>

            <!-- 字符串模糊查询 -->
            <if test="titleKeyword != null and titleKeyword != ''">
                AND title LIKE CONCAT('%', #{titleKeyword}, '%')
            </if>
        </where>
        <choose>
            <when test="orderByField != null and orderByField != ''">
                ORDER BY ${orderByField}
                <if test="orderByDirection != null and orderByDirection != ''">
                    ${orderByDirection}
                </if>
            </when>
            <otherwise>
                ORDER BY create_time DESC
            </otherwise>
        </choose>
        <if test="offset != null and limit != null">
            LIMIT #{offset}, #{limit}
        </if>
    </select>

    <!-- 统计查询 -->
    <select id="selectCount" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM usage_apply
        <where>
            <!-- deleted 参数处理 -->
            <if test="deleted != null">
                deleted = #{deleted}
            </if>
            <if test="deleted == null">
                deleted = 0
            </if>

            <!-- 单值参数 -->
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="draft != null">
                AND draft = #{draft}
            </if>
            <if test="deptId != null">
                AND dept_id = #{deptId}
            </if>

            <!-- IN 查询 -->
            <if test="statusList != null and statusList.size() > 0">
                AND status IN
                <foreach collection="statusList" item="status" open="(" separator="," close=")">
                    #{status}
                </foreach>
            </if>

            <!-- 字符串模糊查询 -->
            <if test="titleKeyword != null and titleKeyword != ''">
                AND title LIKE CONCAT('%', #{titleKeyword}, '%')
            </if>
        </where>
    </select>

    <!-- 分页查询 -->
    <select id="selectPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM usage_apply
        <where>
            <!-- deleted 参数处理 -->
            <if test="query.deleted != null">
                deleted = #{query.deleted}
            </if>
            <if test="query.deleted == null">
                deleted = 0
            </if>

            <!-- 单值参数 -->
            <if test="query.userId != null">
                AND user_id = #{query.userId}
            </if>
            <if test="query.status != null and query.status != ''">
                AND status = #{query.status}
            </if>
            <if test="query.draft != null">
                AND draft = #{query.draft}
            </if>
            <if test="query.deptId != null">
                AND dept_id = #{query.deptId}
            </if>

            <!-- IN 查询 -->
            <if test="query.statusList != null and query.statusList.size() > 0">
                AND status IN
                <foreach collection="query.statusList" item="status" open="(" separator="," close=")">
                    #{status}
                </foreach>
            </if>

            <!-- 字符串模糊查询 -->
            <if test="query.titleKeyword != null and query.titleKeyword != ''">
                AND title LIKE CONCAT('%', #{query.titleKeyword}, '%')
            </if>
        </where>
        <choose>
            <when test="query.orderByField != null and query.orderByField != ''">
                ORDER BY ${query.orderByField}
                <if test="query.orderByDirection != null and query.orderByDirection != ''">
                    ${query.orderByDirection}
                </if>
            </when>
            <otherwise>
                ORDER BY create_time DESC
            </otherwise>
        </choose>
    </select>

    <!-- 自定义查询：根据素材ID和用户ID查询 -->
    <select id="selectByAssetAndUser" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM usage_apply
        <where>
            asset_id = #{assetId}
            AND user_id = #{userId}
            AND status = #{status}
            AND deleted = 0
        </where>
        LIMIT 1
    </select>

    <!-- 插入 -->
    <insert id="insert" parameterType="com.xuanjiao.infrastructure.dataobject.UsageApplyDO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO usage_apply (
            user_id, title, purpose, scope, workflow_id, status, approval_instance_id,
            attachment_path, is_secondary_creation, publish_channel, dept_id, draft,
            create_time, update_time, deleted
        ) VALUES (
            #{userId}, #{title}, #{purpose}, #{scope}, #{workflowId}, #{status}, #{approvalInstanceId},
            #{attachmentPath}, #{isSecondaryCreation}, #{publishChannel}, #{deptId}, #{draft},
            #{createTime}, #{updateTime}, #{deleted}
        )
    </insert>

    <!-- 更新 -->
    <update id="updateById" parameterType="com.xuanjiao.infrastructure.dataobject.UsageApplyDO">
        UPDATE usage_apply
        <set>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="purpose != null">purpose = #{purpose},</if>
            <if test="scope != null">scope = #{scope},</if>
            <if test="workflowId != null">workflow_id = #{workflowId},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="approvalInstanceId != null">approval_instance_id = #{approvalInstanceId},</if>
            <if test="attachmentPath != null">attachment_path = #{attachmentPath},</if>
            <if test="isSecondaryCreation != null">is_secondary_creation = #{isSecondaryCreation},</if>
            <if test="publishChannel != null">publish_channel = #{publishChannel},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="draft != null">draft = #{draft},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="deleted != null">deleted = #{deleted},</if>
        </set>
        <where>
            id = #{id}
        </where>
    </update>

    <!-- 删除（逻辑删除） -->
    <update id="deleteById">
        UPDATE usage_apply
        <set>
            deleted = 1
        </set>
        <where>
            id = #{id}
        </where>
    </update>

    <!-- ==================== 优化的JOIN查询方法（解决N+1问题） ==================== -->

    <!-- ResultMap with Details -->
    <resultMap id="WithDetailsResultMap" type="com.xuanjiao.infrastructure.usage.UsageApplyWithDetailsDO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="title" property="title"/>
        <result column="purpose" property="purpose"/>
        <result column="scope" property="scope"/>
        <result column="workflow_id" property="workflowId"/>
        <result column="status" property="status"/>
        <result column="approval_instance_id" property="approvalInstanceId"/>
        <result column="attachment_path" property="attachmentPath"/>
        <result column="is_secondary_creation" property="isSecondaryCreation"/>
        <result column="publish_channel" property="publishChannel"/>
        <result column="dept_id" property="deptId"/>
        <result column="draft" property="draft"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
        <result column="applicant_name" property="applicantName"/>
    </resultMap>

    <!-- 动态条件查询（带申请人姓名，JOIN查询避免N+1） -->
    <select id="selectListWithDetails" resultMap="WithDetailsResultMap">
        SELECT
            ua.id, ua.user_id, ua.title, ua.purpose, ua.scope, ua.workflow_id, ua.status,
            ua.approval_instance_id, ua.attachment_path, ua.is_secondary_creation, ua.publish_channel,
            ua.dept_id, ua.draft, ua.create_time, ua.update_time, ua.deleted,
            u.real_name AS applicant_name
        FROM usage_apply ua
        LEFT JOIN sys_user u ON ua.user_id = u.id AND u.deleted = 0
        <where>
            <if test="deleted != null">
                ua.deleted = #{deleted}
            </if>
            <if test="deleted == null">
                ua.deleted = 0
            </if>

            <if test="userId != null">
                AND ua.user_id = #{userId}
            </if>
            <if test="status != null and status != ''">
                AND ua.status = #{status}
            </if>
            <if test="draft != null">
                AND ua.draft = #{draft}
            </if>
            <if test="deptId != null">
                AND ua.dept_id = #{deptId}
            </if>

            <if test="statusList != null and statusList.size() > 0">
                AND ua.status IN
                <foreach collection="statusList" item="status" open="(" separator="," close=")">
                    #{status}
                </foreach>
            </if>

            <if test="titleKeyword != null and titleKeyword != ''">
                AND ua.title LIKE CONCAT('%', #{titleKeyword}, '%')
            </if>
        </where>
        <choose>
            <when test="orderByField != null and orderByField != ''">
                ORDER BY ${orderByField}
                <if test="orderByDirection != null and orderByDirection != ''">
                    ${orderByDirection}
                </if>
            </when>
            <otherwise>
                ORDER BY ua.create_time DESC
            </otherwise>
        </choose>
        <if test="offset != null and limit != null">
            LIMIT #{offset}, #{limit}
        </if>
    </select>

</mapper>
