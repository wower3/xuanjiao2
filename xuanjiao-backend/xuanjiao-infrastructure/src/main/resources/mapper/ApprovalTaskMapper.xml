    <insert id="insert" parameterType="com.xuanjiao.infrastructure.dataobject.ApprovalTaskDO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO approval_task (instance_id, stage_id, approver_id, status, comment,
                                   approve_time, next_stage_approver_ids, sub_workflow_approver_ids,
                                   selected_by_user_id, is_first_approver, task_type)
        VALUES (#{instanceId}, #{stageId}, #{approverId}, #{status}, #{comment},
                #{approveTime}, #{nextStageApproverIds}, #{subWorkflowApproverIds},
                #{selectedByUserId}, #{isFirstApprover}, #{taskType})
    </insert>

    <update id="updateById" parameterType="com.xuanjiao.infrastructure.dataobject.ApprovalTaskDO">
        UPDATE approval_task
        <set>
            <if test="instanceId != null">
                instance_id = #{instanceId},
            </if>
            <if test="stageId != null">
                stage_id = #{stageId},
            </if>
            <if test="approverId != null">
                approver_id = #{approverId},
            </if>
            <if test="status != null and status != ''">
