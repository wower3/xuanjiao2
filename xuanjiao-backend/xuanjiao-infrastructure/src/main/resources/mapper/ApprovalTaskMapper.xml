    <!-- ==================== 基础CRUD方法 ==================== -->

    <select id="selectById" resultMap="BaseResultMap" parameterType="java.lang.Long">
        SELECT <include refid="Base_Column_List"/>
        FROM approval_task
        WHERE id = #{id}
        LIMIT 1
    </select>

    <select id="selectOne" resultMap="BaseResultMap" parameterType="com.xuanjiao.infrastructure.approval.ApprovalTaskQuery">
        SELECT <include refid="Base_Column_List"/>
        FROM approval_task
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="instanceId != null">
                AND instance_id = #{instanceId}
            </if>
            <if test="stageId != null">
                AND stage_id = #{stageId}
            </if>
            <if test="approverId != null">
                AND approver_id = #{approverId}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="isFirstApprover != null">
                AND is_first_approver = #{isFirstApprover}
            </if>
            <if test="taskType != null and taskType != ''">
                AND task_type = #{taskType}
            </if>
            <if test="subWorkflowApproverIdsNotNull != null and subWorkflowApproverIdsNotNull">
                AND sub_workflow_approver_ids IS NOT NULL
            </if>
            <if test="statusIn != null and statusIn.size() > 0">
                AND status IN
                <foreach collection="statusIn" item="status" open="(" separator="," close=")">
                    #{status}
                </foreach>
            </if>
            <if test="idNotEqual != null">
                AND id != #{idNotEqual}
            </if>
        </where>
        LIMIT 1
    </select>

