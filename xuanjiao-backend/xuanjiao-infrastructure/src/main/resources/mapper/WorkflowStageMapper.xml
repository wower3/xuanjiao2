<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xuanjiao.infrastructure.workflow.WorkflowStageMapper">

    <!-- Result Map -->
    <resultMap id="BaseResultMap" type="com.xuanjiao.infrastructure.dataobject.WorkflowStageDO">
        <id column="id" property="id"/>
        <result column="workflow_id" property="workflowId"/>
        <result column="name" property="name"/>
        <result column="stage_order" property="stageOrder"/>
        <result column="approve_type" property="approveType"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <!-- Base Column List -->
    <sql id="Base_Column_List">
        id, workflow_id, name, stage_order, approve_type, deleted
    </sql>

    <!-- Select By ID -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM workflow_stage
        WHERE id = #{id} AND deleted = 0
    </select>

    <!-- Select List with Dynamic Conditions -->
    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM workflow_stage
        <where>
            <if test="deleted == null">deleted = 0</if>
            <if test="deleted != null">deleted = #{deleted}</if>
            <if test="id != null">AND id = #{id}</if>
            <if test="workflowId != null">AND workflow_id = #{workflowId}</if>
            <if test="name != null and name != ''">AND name = #{name}</if>
            <if test="stageOrder != null">AND stage_order = #{stageOrder}</if>
            <if test="approveType != null and approveType != ''">AND approve_type = #{approveType}</if>
        </where>
        <if test="orderByField != null and orderByField != ''">
            ORDER BY ${orderByField}
            <if test="orderByDirection != null and orderByDirection != ''">
                ${orderByDirection}
            </if>
        </if>
        <if test="orderByField == null or orderByField == ''">
            ORDER BY stage_order ASC
        </if>
    </select>

    <!-- Select Count -->
    <select id="selectCount" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM workflow_stage
        <where>
            <if test="deleted == null">deleted = 0</if>
            <if test="deleted != null">deleted = #{deleted}</if>
            <if test="id != null">AND id = #{id}</if>
            <if test="workflowId != null">AND workflow_id = #{workflowId}</if>
            <if test="name != null and name != ''">AND name = #{name}</if>
            <if test="stageOrder != null">AND stage_order = #{stageOrder}</if>
            <if test="approveType != null and approveType != ''">AND approve_type = #{approveType}</if>
        </where>
    </select>

    <!-- Insert -->
    <insert id="insert" parameterType="com.xuanjiao.infrastructure.dataobject.WorkflowStageDO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO workflow_stage (workflow_id, name, stage_order, approve_type, deleted)
        VALUES (#{workflowId}, #{name}, #{stageOrder}, #{approveType}, 0)
    </insert>

    <!-- Update By ID -->
    <update id="updateById" parameterType="com.xuanjiao.infrastructure.dataobject.WorkflowStageDO">
        UPDATE workflow_stage
        <set>
            <if test="workflowId != null">workflow_id = #{workflowId},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="stageOrder != null">stage_order = #{stageOrder},</if>
            <if test="approveType != null and approveType != ''">approve_type = #{approveType},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- Delete By ID (Soft Delete using @TableLogic) -->
    <update id="deleteById">
        UPDATE workflow_stage SET deleted = 1 WHERE id = #{id}
    </update>

    <!-- Delete (Batch Soft Delete using WorkflowStageQuery) -->
    <delete id="delete" parameterType="com.xuanjiao.infrastructure.workflow.WorkflowStageQuery">
        UPDATE workflow_stage SET deleted = 1
        <where>
            <if test="id != null">AND id = #{id}</if>
            <if test="workflowId != null">AND workflow_id = #{workflowId}</if>
        </where>
    </delete>

</mapper>
